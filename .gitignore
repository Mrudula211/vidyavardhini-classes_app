# ============================================================
# Vidyavardhini Classes App
# Rule of thumb: commit source, config templates and docs.
# Never commit secrets, build output, generated platform glue or local files.
# ============================================================

# ── Secrets & environment (NEVER COMMIT) ──────────────────────
.env
.env.*
!.env.example
lib/core/constants/supabase_keys.dart
lib/firebase_options.dart
**/android/app/google-services.json
**/ios/Runner/GoogleService-Info.plist
**/macos/Runner/GoogleService-Info.plist
# Signing keys and certificates
**/android/key.properties
!**/android/key.properties.example
*.keystore
*.jks
*.pem
*.p12
*.pfx
*.p8
*.cer
*.mobileprovision
# Firebase / Google service-account keys, any other secret dumps
*service-account*.json
*serviceAccount*.json
*adminsdk*.json
google-credentials*.json
secrets/
.secrets/
*.secret
*.secrets
# Supabase CLI local state and function secrets
supabase/.temp/
supabase/.branches/
supabase/.env
supabase/.env.*
supabase/functions/.env
supabase/functions/.env.*
.supabase/

# ── Flutter / Dart ────────────────────────────────────────────
.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
.packages
.pub-cache/
.pub/
pubspec_overrides.yaml
build/
# Not used (no build_runner codegen); keep stray generated files out
*.g.dart
*.freezed.dart
# Symbolication / obfuscation output
app.*.symbols
app.*.map.json
# Test & coverage output
coverage/
lcov.info
test/.test_coverage.dart
.test_coverage.dart
failures/

