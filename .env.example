# Example environment file for vidyavardhini-classes_app.
# Copy to `.env` and fill in the real values. NEVER commit `.env`.
#
# The Flutter app reads its Supabase settings from
# lib/core/constants/supabase_keys.dart (copy supabase_keys.example.dart and
# fill it in; that file is git-ignored). This file documents the values and is
# for tooling such as `flutter run --dart-define-from-file=.env`.

# Supabase project (Dashboard -> Project Settings -> API)
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
# Client-safe publishable / anon key (it ships inside the app; RLS protects data)
SUPABASE_ANON_KEY=YOUR-PUBLISHABLE-ANON-KEY

# Server-side only. NEVER put these in the Flutter app or in git.
# They are set as Supabase Edge Function secrets with `supabase secrets set`:
#   AUTOMATION_SECRET        shared secret between the database and the functions
#   FIREBASE_SERVICE_ACCOUNT contents of the Firebase service-account JSON
# (SUPABASE_URL and SUPABASE_SERVICE_ROLE_KEY are provided to functions by Supabase.)

# Firebase client config is in files, not env vars:
#   Android: android/app/google-services.json
#   iOS:     ios/Runner/GoogleService-Info.plist
#   Dart:    lib/firebase_options.dart   (generate with `flutterfire configure`)
